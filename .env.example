# DevGuard AI — Environment Configuration Example
# Copy this file to .env and configure appropriate values.
# NEVER commit real API keys, passwords, or secrets to version control.

# Application Environment (development, test, production)
ENVIRONMENT=development
PROJECT_NAME="DevGuard AI"

# Database Configuration (PostgreSQL in production, SQLite fallback in local development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=devguard

# GitHub API Integration (Optional for public repos, recommended to increase rate limits to 5,000 req/hr)
# Generate from: https://github.com/settings/tokens (classic: public_repo scope)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_API_BASE=https://api.github.com
GITHUB_WEBHOOK_SECRET=your_hmac_webhook_secret_here

# LLM Review Engine (Optional: "none", "gemini", "openai", "ollama")
# DevGuard functions 100% reliably on deterministic static analysis without any paid AI API.
LLM_PROVIDER=none
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
OPENAI_API_KEY=sk_your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemini-1.5-flash

# Diff Guardrails & Safety Limits
MAX_DIFF_FILES=50
MAX_DIFF_BYTES=1000000
MAX_REVIEW_TIMEOUT_SECONDS=120

# Security & CORS (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost
API_KEY=
