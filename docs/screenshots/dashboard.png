<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <rect width="1200" height="675" fill="#0b0f19"/>
  <!-- Top Navigation Bar -->
  <rect x="0" y="0" width="1200" height="64" fill="#020617" stroke="#1e293b" stroke-width="1"/>
  <circle cx="40" cy="32" r="14" fill="#0284c7" opacity="0.2"/>
  <path d="M40 22 L48 26 L48 34 C48 38 40 42 40 42 C40 42 32 38 32 34 L32 26 Z" fill="#38bdf8"/>
  <text x="65" y="38" fill="#ffffff" font-family="system-ui, sans-serif" font-size="18" font-weight="bold">DevGuard AI</text>
  <text x="175" y="38" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="14">PR Review Assistant</text>

  <!-- Status pill -->
  <rect x="1040" y="20" width="120" height="26" rx="13" fill="#0f172a" stroke="#1e293b"/>
  <circle cx="1055" cy="33" r="4" fill="#34d399"/>
  <text x="1066" y="38" fill="#94a3b8" font-family="monospace" font-size="11">API READY</text>

  <!-- Header -->
  <text x="60" y="120" fill="#ffffff" font-family="system-ui, sans-serif" font-size="24" font-weight="bold">Security &amp; Quality Dashboard</text>
  <text x="60" y="145" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="14">Real-time pull request review status and findings summary</text>

  <!-- Metrics Cards -->
  <g transform="translate(60, 175)">
    <rect x="0" y="0" width="165" height="90" rx="12" fill="#0f172a" stroke="#1e293b"/>
    <text x="18" y="28" fill="#94a3b8" font-family="system-ui" font-size="11" font-weight="600">TOTAL FINDINGS</text>
    <text x="18" y="62" fill="#ffffff" font-family="system-ui" font-size="28" font-weight="bold">24</text>
    <text x="18" y="78" fill="#64748b" font-family="system-ui" font-size="10">Across all reviews</text>

    <rect x="182" y="0" width="165" height="90" rx="12" fill="#0f172a" stroke="#991b1b" stroke-opacity="0.4"/>
    <text x="200" y="28" fill="#f87171" font-family="system-ui" font-size="11" font-weight="600">CRITICAL</text>
    <text x="200" y="62" fill="#f87171" font-family="system-ui" font-size="28" font-weight="bold">3</text>
    <text x="200" y="78" fill="#f87171" opacity="0.8" font-family="system-ui" font-size="10">Immediate action</text>

    <rect x="364" y="0" width="165" height="90" rx="12" fill="#0f172a" stroke="#9a3412" stroke-opacity="0.4"/>
    <text x="382" y="28" fill="#fb923c" font-family="system-ui" font-size="11" font-weight="600">HIGH</text>
    <text x="382" y="62" fill="#fb923c" font-family="system-ui" font-size="28" font-weight="bold">7</text>
    <text x="382" y="78" fill="#fb923c" opacity="0.8" font-family="system-ui" font-size="10">Security &amp; bugs</text>

    <rect x="546" y="0" width="165" height="90" rx="12" fill="#0f172a" stroke="#78350f" stroke-opacity="0.4"/>
    <text x="564" y="28" fill="#fbbf24" font-family="system-ui" font-size="11" font-weight="600">MEDIUM</text>
    <text x="564" y="62" fill="#fbbf24" font-family="system-ui" font-size="28" font-weight="bold">9</text>
    <text x="564" y="78" fill="#fbbf24" opacity="0.8" font-family="system-ui" font-size="10">Test coverage</text>

    <rect x="728" y="0" width="165" height="90" rx="12" fill="#0f172a" stroke="#1e3a8a" stroke-opacity="0.4"/>
    <text x="746" y="28" fill="#60a5fa" font-family="system-ui" font-size="11" font-weight="600">LOW &amp; INFO</text>
    <text x="746" y="62" fill="#60a5fa" font-family="system-ui" font-size="28" font-weight="bold">5</text>
    <text x="746" y="78" fill="#60a5fa" opacity="0.8" font-family="system-ui" font-size="10">Quality &amp; style</text>

    <rect x="910" y="0" width="165" height="90" rx="12" fill="#0f172a" stroke="#1e293b"/>
    <text x="928" y="28" fill="#94a3b8" font-family="system-ui" font-size="11" font-weight="600">REPOSITORIES</text>
    <text x="928" y="62" fill="#ffffff" font-family="system-ui" font-size="28" font-weight="bold">4</text>
    <text x="928" y="78" fill="#64748b" font-family="system-ui" font-size="10">Connected</text>
  </g>

  <!-- Recent Reviews Table Mockup -->
  <rect x="60" y="295" width="1075" height="340" rx="12" fill="#0f172a" stroke="#1e293b"/>
  <text x="85" y="335" fill="#ffffff" font-family="system-ui" font-size="16" font-weight="600">Recent Pull Request Audits</text>

  <!-- Row 1 -->
  <line x1="60" y1="360" x2="1135" y2="360" stroke="#1e293b"/>
  <text x="85" y="395" fill="#38bdf8" font-family="monospace" font-size="13" font-weight="600">facebook/react #28419</text>
  <rect x="300" y="380" width="80" height="22" rx="11" fill="#064e3b" stroke="#059669"/>
  <text x="318" y="395" fill="#34d399" font-family="system-ui" font-size="11" font-weight="600">COMPLETED</text>
  <text x="400" y="395" fill="#e2e8f0" font-family="system-ui" font-size="13">Fix concurrent fiber reconciliation re-entry memory leak</text>
  <text x="1000" y="395" fill="#f87171" font-family="system-ui" font-size="12" font-weight="600">2 Critical</text>

  <!-- Row 2 -->
  <line x1="60" y1="425" x2="1135" y2="425" stroke="#1e293b"/>
  <text x="85" y="460" fill="#38bdf8" font-family="monospace" font-size="13" font-weight="600">pallets/flask #5612</text>
  <rect x="300" y="445" width="80" height="22" rx="11" fill="#064e3b" stroke="#059669"/>
  <text x="318" y="460" fill="#34d399" font-family="system-ui" font-size="11" font-weight="600">COMPLETED</text>
  <text x="400" y="460" fill="#e2e8f0" font-family="system-ui" font-size="13">Refactor request dispatch routing context and url parameter parser</text>
  <text x="1000" y="460" fill="#34d399" font-family="system-ui" font-size="12" font-weight="600">Clean (0 issues)</text>

  <!-- Row 3 -->
  <line x1="60" y1="490" x2="1135" y2="490" stroke="#1e293b"/>
  <text x="85" y="525" fill="#38bdf8" font-family="monospace" font-size="13" font-weight="600">octocat/Hello-World #12</text>
  <rect x="300" y="510" width="80" height="22" rx="11" fill="#064e3b" stroke="#059669"/>
  <text x="318" y="525" fill="#34d399" font-family="system-ui" font-size="11" font-weight="600">COMPLETED</text>
  <text x="400" y="525" fill="#e2e8f0" font-family="system-ui" font-size="13">Update contribution guidelines and greeting script</text>
  <text x="1000" y="525" fill="#34d399" font-family="system-ui" font-size="12" font-weight="600">Clean (0 issues)</text>
</svg>
